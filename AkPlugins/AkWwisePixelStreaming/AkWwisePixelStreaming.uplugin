{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.0",
	"FriendlyName": "Ak Wwise Pixel Streaming",
	"Description": "Routes the Wwise output mix into Pixel Streaming 2.",
	"Category": "Audio",
	"CreatedBy": "YXK",
	"EnabledByDefault": false,
	"CanContainContent": false,
	"Modules": [
		{
			"Name": "AkWwisePixelStreaming",
			"Type": "Runtime",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [ "Win64", "Linux", "Mac" ],
			"TargetDenyList": [ "Server" ]
		}
	],
	"Plugins": [
		{
			"Name": "Wwise",
			"Enabled": true
		},
		{
			"Name": "PixelStreaming2",
			"Enabled": true
		}
	]
}
