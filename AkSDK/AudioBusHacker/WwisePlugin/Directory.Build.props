<Project>
  <!-- Wwise 2025.1.10 generates vc170 Authoring projects for SDK 10.0.22621.0.
       Use the installed Windows 11 SDK without changing generated projects. -->
  <PropertyGroup Condition="'$(WindowsTargetPlatformVersion)' == '10.0.22621.0' And '$(MSBuildProjectFile)' == 'AudioBusHacker_Authoring_Windows_vc170.vcxproj'">
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
</Project>
