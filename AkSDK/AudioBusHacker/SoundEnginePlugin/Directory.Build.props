<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- VS 18.9 may select an uninstalled 14.51 toolset. Keep vc180 on the
       installed v145 toolset version without affecting vc160/vc170 projects. -->
  <PropertyGroup Condition="'$(MSBuildProjectFile)' == 'AudioBusHacker_Windows_vc180_static.vcxproj' Or '$(MSBuildProjectFile)' == 'AudioBusHacker_Windows_vc180_shared.vcxproj'">
    <VCToolsVersion>14.50.35717</VCToolsVersion>
  </PropertyGroup>
  <!-- Wwise 2025.1.10 targets Windows SDK 10.0.22621.0. Retarget only
       projects generated with that exact version to the installed SDK. -->
  <PropertyGroup Condition="'$(WindowsTargetPlatformVersion)' == '10.0.22621.0' And ('$(MSBuildProjectFile)' == 'AudioBusHacker_Windows_vc170_static.vcxproj' Or '$(MSBuildProjectFile)' == 'AudioBusHacker_Windows_vc170_shared.vcxproj' Or '$(MSBuildProjectFile)' == 'AudioBusHacker_Windows_vc180_static.vcxproj' Or '$(MSBuildProjectFile)' == 'AudioBusHacker_Windows_vc180_shared.vcxproj')">
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
</Project>
